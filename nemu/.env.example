NODE_ENV=development
HOST=127.0.0.1
PORT=3001
DATABASE_URL=postgres://nemu:change-me@localhost:5434/nemu

# Comma-separated OAuth client IDs permitted to mint sessions.
GOOGLE_OAUTH_CLIENT_IDS=your-google-oauth-client-id.apps.googleusercontent.com

# Exactly 32 random bytes, base64 encoded. Generate: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
MEMORY_ENCRYPTION_KEY_BASE64=

# Minimum 32 random characters. Used only to sign short-lived NEMU sessions.
JWT_SECRET=

# Explicit model configuration; do not change a model without a compatible vector migration.
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
CHAT_PROVIDER=openai
CHAT_MODEL=gpt-4.1-mini
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna

# Chat fallback: DeepSeek is attempted first; OpenAI is used only for retryable failures.
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Origins allowed to call the API; use specific origins in production.
CORS_ORIGINS=http://localhost:5173
