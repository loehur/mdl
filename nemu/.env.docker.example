# Copy to .env.docker and replace all values before any public deployment.
NODE_ENV=development
POSTGRES_DB=nemu
POSTGRES_USER=nemu
POSTGRES_PASSWORD=change-this-postgres-password
DATABASE_URL=postgres://nemu:change-this-postgres-password@postgres:5432/nemu

HOST=0.0.0.0
PORT=3001
CORS_ORIGINS=http://localhost:8080
GOOGLE_OAUTH_CLIENT_IDS=your-google-oauth-client-id.apps.googleusercontent.com
MEMORY_ENCRYPTION_KEY_BASE64=
JWT_SECRET=
OPENAI_API_KEY=
OPENAI_MODEL=gpt-5.6-luna
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat
EMBEDDING_PROVIDER=openai
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSIONS=1536
VITE_API_BASE_URL=/api
# Public OAuth client ID (not a client secret).
VITE_GOOGLE_CLIENT_ID=
