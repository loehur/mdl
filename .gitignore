node_modules/
Env.php
.env
*copy*
*.sql

# Generated Android artifacts and distributable packages.
android/**/build/
android/**/*.apk
android/**/*.aab

# Runtime user uploads must live on server/object storage, never in Git.
api/uploads/

# Packaged application binaries are release artifacts, not source code.
laundry/in_assets/files/*.apk

# NEMU database migrations are application source and must be deployed.
!nemu/migrations/
!nemu/migrations/*.sql

# Schema & migrasi API (kecuali seed ber-kredensial)
!api/database/
!api/database/**/
!api/database/**/*.sql
api/database/**/seeds/

# Sandbox API tester (lokal, jangan ikut commit)
/api_tester/

# Command Code setup lokal per-developer (settings machine-specific; taste/ di-push ke cloud ai)
.commandcode/settings.json
.commandcode/taste/

# Graphify generated knowledge graph and cache
/graphify-out/

# OpenCode local configuration
.opencode/
