# HTTP server
PORT=3025
HOST=0.0.0.0

# Fonnte API token — samakan dengan Env::FONNTE_TOKEN di api/app/Config/Env.php
FONNTE_TOKEN=change-me-fonnte-token

# Webhook PHP (WA_Fonnte) — sama endpoint yang dulu di dashboard Fonnte
# Dev XAMPP:  http://localhost/mdl/api/Webhook/WA_Fonnte
# Production: https://api.nalju.com/Webhook/WA_Fonnte
WEBHOOK_URL=http://localhost/mdl/api/Webhook/WA_Fonnte

# URL publik file media (harus bisa diakses server PHP)
# Dev:  http://127.0.0.1:3025
# VPS:  http://127.0.0.1:3025 (satu server) atau https://wa.nalju.com
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:3025

# Nomor device (opsional, auto dari sesi WA). Format: 08117686252
DEVICE_NUMBER=

# Kode negara default saat normalisasi nomor (Fonnte: 62)
COUNTRY_CODE=62

# Retry webhook jika gagal
WEBHOOK_RETRY=3
WEBHOOK_TIMEOUT_MS=15000
