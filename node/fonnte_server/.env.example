# HTTP server
PORT=3025
HOST=0.0.0.0

# Fonnte API token — samakan dengan Env::FONNTE_TOKEN di api/app/Config/Env.php
FONNTE_TOKEN=change-me-fonnte-token

# Webhook personal chat — KOSONGKAN (group send only). Jangan arahkan ke WA_Fonnte.
WEBHOOK_URL=

# URL publik file media (harus bisa diakses server PHP)
# Dev:  http://127.0.0.1:3025
# VPS:  http://127.0.0.1:3025 (satu server) atau https://wa.nalju.com
MEDIA_PUBLIC_BASE_URL=http://127.0.0.1:3025

# Nomor device untuk group WA (bukan line YCloud admin/cs). Format: 08xxxxxxxxxx
DEVICE_NUMBER=

# Kode negara default saat normalisasi nomor (Fonnte: 62)
COUNTRY_CODE=62

# Retry webhook jika gagal (tidak dipakai bila WEBHOOK_URL kosong)
WEBHOOK_RETRY=3
WEBHOOK_TIMEOUT_MS=15000

# Mirror LID map ke PHP (open_basedir api/data). Production VPS:
# LID_MAP_MIRROR_FILE=/www/wwwroot/mdl/api/data/lid_phone_map.json
LID_MAP_MIRROR_FILE=

# Log upsert Baileys ke data/upsert_debug.log (diagnosis pesan HP tidak masuk)
DEBUG_UPSERT=1
