PORT=3003
AllowedOrigins=http://localhost,http://localhost:8080,https://ml.nalju.com,https://cms.nalju.com

# OneSignal Push Notification
ONESIGNAL_APP_ID=your-onesignal-app-id
ONESIGNAL_REST_API_KEY=your-onesignal-rest-api-key

# ⚠️ IMPORTANT: This MUST match the channel ID from OneSignal Dashboard
# AND the CHANNEL_ID in android/MainApplication.kt
# Format is UUID from OneSignal Dashboard (e.g. 7bf3bcb6-e151-4e8a-ae41-fd98692b80a3)
ONESIGNAL_ANDROID_CHANNEL_ID=7bf3bcb6-e151-4e8a-ae41-fd98692b80a3
# API Configuration (Optional - defaults to https://api.nalju.com/CRM/Roles)
API_URL=https://api.nalju.com/CRM/Roles
