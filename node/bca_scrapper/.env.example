PORT=3021
HOST=0.0.0.0

# Opsional: jika diisi, client wajib kirim header X-Bca-Token
BCA_SCRAPPER_TOKEN=

# Kredensial default KlikBCA Individual (bisa dioverride lewat request body)
BCA_USERNAME=
BCA_PASSWORD=

# Kredensial QR Merchant Service — qr.klikbca.com (transaksi QRIS)
BCA_QRMS_EMAIL=
BCA_QRMS_PASSWORD=

# Timeout HTTP ke ibank.klikbca.com (ms)
HTTP_TIMEOUT_MS=30000

# Puppeteer fallback
PUPPETEER_HEADLESS=true
PUPPETEER_TIMEOUT_MS=60000
# VPS Linux: wajib npm run install:chrome setelah npm install
# Opsional — pakai Chromium system jika sudah terinstall:
# PUPPETEER_EXECUTABLE_PATH=/usr/bin/chromium-browser
# PUPPETEER_CACHE_DIR=/root/.cache/puppeteer

# Debug: simpan HTML + log step ke folder debug/ (jangan commit)
BCA_DEBUG=false

# Batasan rentang /mutasi (server-side)
# MUTASI_MAX_RANGE_DAYS=6
# MUTASI_MAX_LOOKBACK_DAYS=30

# Batasan /qris/transactions — max kemarin + hari ini (2 hari), lookback max 1 hari
# QRIS_MAX_RANGE_DAYS=2
# QRIS_MAX_LOOKBACK_DAYS=1
# TZ=Asia/Jakarta

# Cooldown antar scrape ke KlikBCA (ms). Default 9 menit = 540000
# Cooldown antar scrape ke KlikBCA (ms). Default 9 menit = 540000
BALANCE_COOLDOWN_MS=540000
MUTASI_COOLDOWN_MS=540000
QRIS_COOLDOWN_MS=540000
